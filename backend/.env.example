APP_NAME="Keymarket API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=single
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
# Generate once with: php artisan marketplace:inventory-secret
KEY_FINGERPRINT_SECRET=
BOOST_ENABLED=false
TRUSTED_PROXIES=
ALLOW_DEMO_SEEDING=false
SEED_DEMO_ON_FIRST_BOOT=false

APP_NAME=Keymarket
APP_ENV=production
APP_DEBUG=false
# Replace with the verified public origin. Render entrypoint falls back to RENDER_EXTERNAL_URL if omitted.
APP_URL=https://your-service.onrender.com
# Generate once with php artisan key:generate --show; retain the base64: prefix.
APP_KEY=
# Stable separate random secret, at least 32 characters. Never regenerate after importing inventory.
KEY_FINGERPRINT_SECRET=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
# Neon DIRECT (not -pooler) URL. URL-encode credentials; select PostgreSQL 18 and replace sslmode with verify-full.
DB_URL=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/marketplace?sslmode=verify-full
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
# Trust all calling proxy addresses only behind the managed Render ingress. Otherwise list proxy IPs/CIDRs.
TRUSTED_PROXIES=*
# Explicit public internship demo only; first-boot seeding skips any nonempty product catalog.
ALLOW_DEMO_SEEDING=true
SEED_DEMO_ON_FIRST_BOOT=true
BOOST_ENABLED=false
PORT=10000
